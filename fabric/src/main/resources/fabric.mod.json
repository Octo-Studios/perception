{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "environment": "client",
  "entrypoints": {
    "main": [
      "${mod_group}.fabric.PerceptionFabric"
    ],
    "client": [
      "${mod_group}.fabric.PerceptionFabricClient"
    ]
  },
  "mixins": [
    "${mod_id}-common.mixins.json",
    "${mod_id}-fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.13",
    "minecraft": ">=1.21.4",
    "java": ">=21",
    "architectury": ">=15.0.3",
    "octolib": ">=0.5.0.1",
    "fabric-api": "*"
  }
}
